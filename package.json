{
  "name": "vue-form-errors",
  "version": "0.1.0",
  "description": "Vue 3 composable that wires server validation errors (e.g. a 422) to form fields accessibly: aria-invalid, aria-describedby, and focus on the first error in page order.",
  "license": "MIT",
  "author": "Jeremy Leo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leojeremy/vue-form-errors.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "composable",
    "forms",
    "validation",
    "accessibility",
    "a11y",
    "aria",
    "laravel",
    "422"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "vite example",
    "example:build": "vite build example",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
